  "license": "ASL2",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "semver": "^7.8.5",
    "tail": "^2.2.6",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@types/tail": "^2.2.3",
    "@types/which": "^3.0.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
